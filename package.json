{
  "name": "switchboard",
  "version": "0.1.0",
  "description": "Personal macOS app for meeting transcription and a menu-bar calendar",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:calendar-listener": "node scripts/build-macos-calendar-listener.js",
    "compile:audio-tap": "node scripts/build-macos-audio-tap.js",
    "compile:native": "npm run compile:mic-listener && npm run compile:calendar-listener && npm run compile:audio-tap",
    "prestart": "npm run compile:native && npm run download:meeting-aec-helper && npm run download:sherpa-onnx && npm run download:whisper-vad-model",
    "start": "electron .",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "npm run compile:native && npm run download:whisper-cpp && npm run download:meeting-aec-helper && npm run download:sherpa-onnx && npm run download:whisper-vad-model",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "build": "npm run build:mac",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "compile:mac-icon": "node scripts/compile-macos-icon.js",
    "prebuild:mac": "npm run compile:native && npm run compile:mac-icon && npm run download:whisper-cpp && npm run download:sherpa-onnx && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:diarization-models -- --output-dir resources/bin/diarization-models",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:mac:arm64": "npm run build:renderer && electron-builder --mac --arm64",
    "build:mac:x64": "npm run build:renderer && electron-builder --mac --x64",
    "prepack": "npm run compile:native && npm run download:whisper-cpp && npm run download:sherpa-onnx && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:diarization-models -- --output-dir resources/bin/diarization-models",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.js --current",
    "download:sherpa-onnx": "node scripts/download-sherpa-onnx.js --current",
    "download:meeting-aec-helper": "node scripts/download-meeting-aec-helper.js --current",
    "download:diarization-models": "node scripts/download-diarization-models.js",
    "download:whisper-vad-model": "node scripts/download-whisper-vad-model.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "node --import tsx --test --test-timeout=60000 \"test/**/*.test.js\"",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "npm run format:check && npm run typecheck",
    "preview": "cd src && vite preview"
  },
  "keywords": [
    "meeting-transcription",
    "speech-to-text",
    "whisper",
    "electron",
    "macos"
  ],
  "author": {
    "name": "Rogerio Goncalves",
    "email": "rogerlz@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.4.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "17.5.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@napi-rs/keyring": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-direction": "1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-virtual": "^3.13.2",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "better-sqlite3": "12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.1",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^26.3.6",
    "onnxruntime-node": "^1.21.0",
    "opencc-js": "^1.4.1",
    "ps-list": "^9.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.22",
    "tinfoil": "^1.1.8",
    "tiptap-markdown": "^0.9.0",
    "unbzip2-stream": "^1.4.3",
    "unzipper": "^0.12.3",
    "ws": "8.21.0",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-bullet-list": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-dropcursor": "3.31.3",
    "@tiptap/extension-floating-menu": "3.31.3",
    "@tiptap/extension-gapcursor": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-list-item": "3.31.3",
    "@tiptap/extension-list-keymap": "3.31.3",
    "@tiptap/extension-ordered-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@xmldom/xmldom": "0.8.15",
    "fast-xml-builder": "1.2.0",
    "fast-xml-parser": "5.7.2",
    "ip-address": "10.2.0",
    "markdown-it": "14.2.0",
    "tmp": "0.2.7"
  },
  "allowScripts": {
    "electron@41.10.5": true,
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true,
    "onnxruntime-node@1.27.0": true,
    "better-sqlite3@12.9.0": true,
    "electron-winstaller": false,
    "fsevents": false
  }
}
