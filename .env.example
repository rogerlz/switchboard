# Copy to .env (bundled into builds) or to
# ~/Library/Application Support/switchboard/.env (read at launch; use
# Switchboard-development/ for `npm run dev`). Never commit real values.

# Google Calendar: OAuth client of type "Desktop app" with the Calendar API
# enabled and the calendar.events + calendar.calendarlist.readonly scopes.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Calendar: Azure app registration (public client) with a
# http://localhost redirect and Calendars.Read.
MICROSOFT_CALENDAR_CLIENT_ID=

# Optional: debug, info, warn or error.
OPENWHISPR_LOG_LEVEL=

# Optional: where downloaded models live (default ~/.cache/openwhispr).
OPENWHISPR_CACHE_ROOT=
