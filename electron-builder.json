{
  "appId": "com.rogerlz.switchboard",
  "afterPack": "scripts/afterPack.js",
  "productName": "Switchboard",
  "directories": {
    "output": "dist"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/helpers/**/*",
    "src/workers/**/*",
    "src/config/**/*",
    "src/constants/**/*",
    "src/locales/**/*",
    "src/hooks/**/*",
    "src/models/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",
    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",
    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",
    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",
    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",
    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**"
  ],
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**/*",
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/onnxruntime-node/**/*",
    "**/node_modules/@napi-rs/keyring/**/*",
    "src/workers/**/*"
  ],
  "extraResources": [
    ".env",
    {
      "from": "src/assets",
      "to": "src/assets",
      "filter": ["**/*", "!fonts/yowza/**"]
    },
    {
      "from": "resources/bin/",
      "to": "bin/",
      "filter": [
        "whisper-server-*",
        "sherpa-onnx-*",
        "macos-audio-tap",
        "macos-mic-listener",
        "macos-calendar-listener",
        "macos-disclaim-exec",
        "meeting-aec-helper-*",
        "diarization-models/**/*",
        "whisper-vad/**/*",
        "*.dylib"
      ]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": ["dmg", "zip"],
    "icon": "src/assets/icon.icns",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "extraResources": [
      {
        "from": "src/assets/Assets.car",
        "to": "Assets.car"
      }
    ],
    "extendInfo": {
      "LSUIElement": false,
      "CFBundleIconName": "openwhispr",
      "NSMicrophoneUsageDescription": "Switchboard uses the microphone to capture your voice for transcription.",
      "NSAudioCaptureUsageDescription": "Switchboard uses system audio to capture other participants' audio from calls and meetings.",
      "NSCalendarsUsageDescription": "Switchboard reads your calendar to detect upcoming meetings and link meeting notes to events.",
      "NSCalendarsFullAccessUsageDescription": "Switchboard reads your calendar to detect upcoming meetings and link meeting notes to events."
    }
  },
  "dmg": {
    "title": "Switchboard",
    "icon": "src/assets/icon.icns",
    "window": {
      "width": 540,
      "height": 380
    }
  }
}
